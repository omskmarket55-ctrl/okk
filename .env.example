# Публичный адрес кабинета
PUBLIC_URL=https://okk.unosystem.ru

# PostgreSQL (для docker compose; DATABASE_URL собирается из пароля автоматически)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://okk:okk@localhost:5432/okk

# Секрет подписи сессий и ключ шифрования телефонов (openssl rand -base64 32).
# PHONE_KEY нельзя менять и терять: без него зашифрованные номера не расшифровать.
SESSION_SECRET=change-me-to-a-long-random-string
PHONE_KEY=

# Первый администратор: создаётся при первом запуске, если в базе нет сотрудников
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=

# Битрикс24: входящий вебхук с правами CRM и «Пользователи» (crm, user)
BITRIX_WEBHOOK_URL=
# Токен исходящего вебхука на событие «Добавление дела» (ONCRMACTIVITYADD), необязательно
BITRIX_OUTGOING_TOKEN=

# UIS: постоянный ключ пользователя с доступом к Call API; секрет в адресе уведомлений о звонках
UIS_ACCESS_TOKEN=
UIS_HOOK_KEY=

# 1 — демо-данные: примерные клиенты и оператор operator / operator-demo
DEMO=0
PORT=3000
